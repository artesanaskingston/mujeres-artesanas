<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="only light">
<meta name="darkreader-lock">
<title>Mujeres Artesanas de Kingston</title>
<meta name="description" content="Mujeres Artesanas de Kingston: arte, tradición y comunidad para mujeres inmigrantes hispanohablantes en Kingston, NY.">
<link rel="icon" href="img/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
{% raw %}
:root{
  color-scheme:only light;
  --cream:#F4EEE3; --cream2:#EAE1D1; --paper:#FFFDF8; --ink:#2A3340; --soft:#5A6270;
  --green:#36A176; --dkgreen:#295740; --teal:#97D2CA; --yellow:#F7BC38;
  --blue:#0066A8; --magenta:#A61E56; --orange:#F05F3E;
  --serif:"Cormorant Garamond",Georgia,serif; --sans:"Montserrat",system-ui,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--cream);color:var(--ink);font:300 17px/1.65 var(--sans)}
img{max-width:100%;display:block}
a{color:var(--dkgreen)}
h1,h2,h3{text-wrap:balance;font-family:var(--serif);font-weight:500;line-height:1.08;letter-spacing:-.01em;margin:0 0 .35em}
h1{font-size:clamp(2.6rem,6vw,4.6rem)}
h2{font-size:clamp(2rem,4vw,3rem)}
h3{font-size:1.6rem}
p{margin:0 0 1em}
strong{font-weight:600}
.kicker{font:700 .72rem/1 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--green);margin:0 0 .9rem}
.wrap{max-width:1120px;margin:0 auto;padding:0 28px}

/* bilingual */
html[lang="es"] .en, html[lang="en"] .es{display:none !important}

/* header */
header{position:sticky;top:0;z-index:20;background:rgba(244,238,227,.96);backdrop-filter:blur(6px);border-bottom:1px solid var(--cream2)}
.head{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:12px 28px;max-width:1240px;margin:0 auto}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink)}
.brand img{width:54px;height:54px}
.brand span{font:600 1.25rem/1 var(--serif)}
nav{display:flex;align-items:center;gap:22px;font:500 .82rem var(--sans);letter-spacing:.04em}
nav a{color:var(--ink);text-decoration:none;padding:4px 0;border-bottom:2px solid transparent;white-space:nowrap}
nav a.on{border-color:var(--navc,var(--green))}
.tools{display:flex;align-items:center;gap:12px}
.lang{display:flex;border:1.5px solid var(--ink);border-radius:20px;overflow:hidden}
.lang button{all:unset;cursor:pointer;font:600 .72rem var(--sans);padding:5px 10px;letter-spacing:.08em}
.lang button[aria-pressed="true"]{background:var(--ink);color:var(--cream)}
.btn{display:inline-block;font:700 .82rem var(--sans);letter-spacing:.04em;text-decoration:none;border-radius:24px;padding:11px 20px;cursor:pointer;border:0}
.btn.y{background:var(--yellow);color:var(--ink)}
.btn.g{background:var(--green);color:#fff}
.btn.o{background:transparent;border:1.5px solid currentColor;color:inherit}
.menu-btn{display:none}
.nav-donar{display:none}
@media (max-width:900px){
  .head{flex-wrap:wrap;padding:10px 18px}
  .brand img{width:40px;height:40px}
  .brand{gap:9px}
  .brand span{font-size:1.08rem}
  .tools{gap:8px}
  .tools .btn{display:none}
  .menu-btn{all:unset;cursor:pointer;display:flex;flex-direction:column;justify-content:center;gap:5px;width:40px;height:40px;border-radius:8px;align-items:center}
  .menu-btn span{display:block;width:22px;height:2px;background:var(--ink);border-radius:2px;transition:transform .25s ease,opacity .2s ease}
  header.open .menu-btn span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  header.open .menu-btn span:nth-child(2){opacity:0}
  header.open .menu-btn span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  header nav{order:3;width:100%;display:none;flex-direction:column;align-items:stretch;gap:0;padding:6px 0 8px;font-size:1rem}
  header.open nav{display:flex}
  header nav a{padding:12px 2px;border-bottom:1px solid var(--cream2)}
  header nav a:last-child{border-bottom:0}
  header nav a.nav-donar{display:block;align-self:flex-start;margin-top:12px;padding:11px 22px;border:0;border-radius:24px;background:var(--yellow);color:var(--ink);font-weight:700}
  header nav a.on{border-bottom-color:var(--cream2);box-shadow:inset 4px 0 0 var(--navc,var(--green));padding-left:14px}
}

/* views */
.view{display:none}
.view.on{display:block;animation:fade .35s ease}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
section{padding:72px 0}
.band{background:var(--green);color:#fff}
.band .kicker{color:var(--teal)}
.band a{color:#fff}
.paper{background:var(--paper)}

/* page headers, one system for every page (mirrors the proposal's page cards) */
.view[data-c="green"]{--c:var(--green)} .view[data-c="yellow"]{--c:var(--yellow)}
.view[data-c="orange"]{--c:var(--orange)} .view[data-c="magenta"]{--c:var(--magenta)} .view[data-c="blue"]{--c:var(--blue)}
.pagehead{border-top:8px solid var(--c)}
.pagehead .banner{height:260px;background-position:center;background-size:cover;background-repeat:no-repeat}
.pagehead .banner.emblem{background-size:auto 150px}
.pagehead .intro{padding-top:46px;padding-bottom:10px}
.pagehead h1{font-size:clamp(2.6rem,5.5vw,4rem);margin-bottom:0}
.pagehead .alt{font:italic 500 1.5rem/1.2 var(--serif);color:var(--soft);margin:2px 0 18px}
.pagehead .lead{font-size:1.12rem;font-weight:400;max-width:720px}
.view .kicker{color:var(--c)}
.band .kicker{color:var(--teal)}
@media (max-width:700px){.pagehead .banner{height:180px}.pagehead .banner.emblem{background-size:auto 110px}}

/* hero */
.hero{position:relative;min-height:560px;border-top:8px solid var(--green);display:flex;align-items:flex-end;background-size:cover;background-repeat:no-repeat;padding:0}
.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(42,51,64,.35),rgba(42,51,64,0) 55%)}
.hero .card{position:relative;z-index:1;background:rgba(244,238,227,.95);padding:34px 40px 30px;margin:0 0 56px;max-width:640px}
.hero .card p{font-size:1.08rem;font-weight:400}
.hero .zig{position:absolute;z-index:2;width:58px}
.btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}

.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;text-align:center}
.stat b{display:block;font:500 3.3rem/1 var(--serif);color:var(--blue);margin-bottom:6px}
.stat span{font-size:.88rem}
@media (max-width:760px){.stats{grid-template-columns:repeat(2,1fr)}}

.three{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
.feat{background:var(--paper);border-radius:6px;padding:28px 26px;position:relative;overflow:hidden}
.feat img.icon{width:46px;height:46px;object-fit:contain;margin-bottom:14px}
.feat h3{margin-bottom:.4em}
@media (max-width:860px){.three{grid-template-columns:1fr}}

.quote{position:relative;max-width:820px;margin:0 auto;text-align:center}
.quote blockquote{margin:0;font:italic 500 clamp(1.6rem,3.2vw,2.3rem)/1.3 var(--serif)}
.quote cite{display:block;margin-top:14px;font:500 .8rem var(--sans);letter-spacing:.14em;text-transform:uppercase;font-style:normal;opacity:.85}

.split{display:grid;grid-template-columns:1.15fr 1fr;gap:56px;align-items:center}
.split.rev{grid-template-columns:1fr 1.15fr}
@media (max-width:860px){.split,.split.rev{grid-template-columns:1fr;gap:32px}}
.slice{clip-path:polygon(0 4%,100% 0,100% 96%,0 100%);border-radius:2px}
.slice2{clip-path:polygon(0 0,100% 6%,100% 100%,0 93%)}

.next{background:var(--paper);border-left:6px solid var(--yellow);padding:26px 30px;border-radius:4px}
.next .date{font:700 .78rem var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--orange)}

ul.dots{list-style:none;padding:0;margin:0}
ul.dots li{position:relative;padding-left:24px;margin-bottom:10px}
ul.dots li:before{content:"";position:absolute;left:0;top:.62em;width:10px;height:10px;border-radius:50%;background:var(--green)}
.band ul.dots li:before{background:var(--yellow)}

.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}
.chip{background:var(--paper);border-radius:20px;padding:8px 16px;font-size:.9rem;font-weight:500}
.chip i{font-style:normal;color:var(--soft);font-weight:300}

/* gallery: trapezium slices, 50/50 pairs, morph to full picture on hover */
.gallery{--cut:90px;--g:16px;--h:320px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:0;row-gap:15.4px}
/* row gap = perpendicular width of the diagonal gap: g*h/sqrt(h^2+cut^2) */
.gallery figure{position:relative;margin:0;height:var(--h);overflow:hidden;outline:none;z-index:1;
  width:calc(100% + (var(--cut) - var(--g)) / 2);
  transition:clip-path .45s cubic-bezier(.4,0,.2,1)}
.gallery figure:nth-child(even){margin-left:calc((var(--g) - var(--cut)) / 2)}
.gallery img{width:100%;height:100%;object-fit:cover}
.gallery figure:nth-child(4n+1){clip-path:polygon(0 0,100% 0,calc(100% - var(--cut)) 100%,0 100%)}
.gallery figure:nth-child(4n+2){clip-path:polygon(var(--cut) 0,100% 0,100% 100%,0 100%)}
.gallery figure:nth-child(4n+3){clip-path:polygon(0 0,calc(100% - var(--cut)) 0,100% 100%,0 100%)}
.gallery figure:nth-child(4n+4){clip-path:polygon(0 0,100% 0,100% 100%,var(--cut) 100%)}
.gallery figure:nth-child(n):is(:hover,:focus-within){clip-path:polygon(0 0,100% 0,100% 100%,0 100%)}
/* the partner's diagonal straightens to vertical, keeping the gap, so nothing overlaps */
@media (min-width:701px){
  .gallery figure:nth-child(odd):is(:hover,:focus-within) + figure{clip-path:polygon(var(--cut) 0,100% 0,100% 100%,var(--cut) 100%)}
  .gallery figure:nth-child(odd):has(+ figure:is(:hover,:focus-within)){clip-path:polygon(0 0,calc(100% - var(--cut)) 0,calc(100% - var(--cut)) 100%,0 100%)}
}
.gallery figcaption{position:absolute;left:0;right:0;bottom:0;padding:14px 22px;background:rgba(42,51,64,.62);color:#fff;font:500 .88rem/1.4 var(--sans);opacity:0;transform:translateY(8px);transition:opacity .3s ease .1s,transform .3s ease .1s}
.gallery figure:hover figcaption,.gallery figure:focus figcaption,.gallery figure:focus-within figcaption{opacity:1;transform:none}
@media (hover:none){.gallery figcaption{opacity:1;transform:none}
  .gallery figure:nth-child(odd) figcaption{padding-right:calc(var(--cut) + 18px)}
  .gallery figure:nth-child(even) figcaption{padding-left:calc(var(--cut) + 18px)}}
@media (max-width:700px){
  .gallery{--cut:50px;--h:240px;grid-template-columns:1fr;row-gap:var(--g)}
  .gallery figure:nth-child(n){width:100%;margin-left:0}
  .gallery figure:nth-child(n),.gallery figure:nth-child(n):is(:hover,:focus-within){clip-path:none}
  .gallery figure:nth-child(n) figcaption{padding-left:18px;padding-right:18px}
}

/* flipbook */
.fb-wrap{display:flex;flex-direction:column;align-items:center;gap:18px}
.fb-stage{width:100%;max-width:1000px;margin:0 auto}
.fb-page{background:#fff}
/* while the book is closed on its cover there is no left page, so no outer shadow */
body.fb-closed .stf__outerShadow,body.fb-closed .stf__hardShadow,body.fb-closed .stf__hardInnerShadow{display:none !important}
.fb-page img{width:100%;height:100%;object-fit:cover;display:block}
.fb-ctrl{display:flex;align-items:center;gap:16px;font:500 .85rem var(--sans)}
.fb-ctrl button{all:unset;cursor:pointer;width:42px;height:42px;border-radius:50%;background:var(--ink);color:var(--cream);display:grid;place-items:center;font-size:1.1rem}
.fb-ctrl button:disabled{opacity:.3;cursor:default}
.fb-hint{font-size:.82rem;color:var(--soft)}
.fb-intro{max-width:680px}
.fb-intro>:last-child{margin-bottom:.4em}
.fb-ctrl .fb-fullbtn{margin-left:12px;background:transparent;color:var(--ink);border:1.5px solid var(--ink);font-size:1.15rem}
.fb-full{position:fixed;inset:0;z-index:100;background:rgba(20,24,30,.96);display:flex;align-items:center;justify-content:center;padding:56px 24px 24px}
.fb-full[hidden]{display:none}
.fb-full-slot{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px}
.fb-full .fb-stage{max-width:none;width:auto}
.fb-full .fb-ctrl{color:#fff}
.fb-full .fb-ctrl button{background:rgba(255,255,255,.15);color:#fff}
.fb-full .fb-ctrl .fb-fullbtn{display:none}
.fb-close{all:unset;cursor:pointer;position:absolute;top:14px;right:16px;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:1.3rem;background:rgba(255,255,255,.12)}
.fb-close:hover{background:rgba(255,255,255,.25)}
/* donate steps */
.steps3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:22px 0 26px;max-width:960px}
.steps3 div{background:var(--paper);border-radius:6px;padding:18px 20px;border-top:5px solid var(--c)}
.steps3 b{display:block;font:700 .72rem var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--c);margin-bottom:6px}
.copyline{display:flex;gap:8px;align-items:center;margin-top:8px;flex-wrap:wrap}
.copyline code{background:var(--cream);padding:5px 9px;border-radius:4px;font:600 .85rem var(--sans)}
.copyline button{all:unset;cursor:pointer;font:600 .75rem var(--sans);border:1.5px solid var(--ink);border-radius:14px;padding:4px 10px}
@media (max-width:760px){.steps3{grid-template-columns:1fr}}

/* lightbox slideshow */
.gallery img{cursor:zoom-in}
.lb{position:fixed;inset:0;z-index:100;background:rgba(20,24,30,.95);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:14px;padding:20px}
.lb[hidden]{display:none}
.lb img{max-width:min(92vw,1400px);max-height:80vh;object-fit:contain;box-shadow:0 20px 60px rgba(0,0,0,.5);transition:opacity .25s ease}
.lb img.fading{opacity:0}
.lb-cap{color:#fff;font:500 .95rem/1.4 var(--sans);text-align:center;max-width:80vw}
.lb-n{color:rgba(255,255,255,.6);font:600 .75rem var(--sans);letter-spacing:.14em}
.lb button{all:unset;cursor:pointer;position:absolute;color:#fff;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;font-size:1.6rem;background:rgba(255,255,255,.1)}
.lb button:hover,.lb button:focus-visible{background:rgba(255,255,255,.25)}
.lb .lb-x{top:18px;right:18px}
.lb .lb-fs{top:18px;right:82px}
.lb .lb-fs[hidden]{display:none}
.lb:fullscreen{background:#111}
.lb:fullscreen img{max-width:98vw;max-height:88vh}
.lb .lb-prev{left:18px;top:50%;transform:translateY(-50%)}
.lb .lb-next{right:18px;top:50%;transform:translateY(-50%)}
@media (max-width:700px){.lb .lb-prev,.lb .lb-next{top:auto;bottom:18px;transform:none}}

/* events */
.events{display:grid;grid-template-columns:minmax(0,1fr);gap:18px}
.ev{display:grid;grid-template-columns:220px 1fr;gap:24px;background:var(--paper);border-left:6px solid var(--orange);border-radius:4px;padding:20px 24px;align-items:start}
.ev.noimg{grid-template-columns:minmax(0,1fr)}
.ev>*{min-width:0}
.ev,.next{overflow-wrap:anywhere}
a.em{overflow-wrap:anywhere}
.em-at::before{content:"@"}
.em-at::after{content:"\200B"}
footer a.em{overflow-wrap:normal}
.ev-desc table,.fb-intro table{display:block;overflow-x:auto}
.ev-img img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:3px;display:block}
.ev h3{margin:6px 0 4px}
.ev-head{display:flex;gap:16px;align-items:center;margin-bottom:12px}
.ev-head h3{margin:2px 0 4px}
.cal{flex:0 0 auto;width:82px;background:#fff;border:1px solid var(--cream2);border-radius:8px;overflow:hidden;text-align:center;line-height:1}
.cal-m{background:var(--orange);color:#fff;font:700 .68rem/1 var(--sans);letter-spacing:.1em;padding:6px 2px 5px;text-transform:uppercase}
.cal-d{font:500 2.5rem/1 var(--serif);padding:6px 0 2px;color:var(--ink)}
.cal-w{font:500 .66rem/1.2 var(--sans);color:var(--soft);padding:0 4px 7px}
.cal-t{border-top:1px solid var(--cream2);margin:0 8px;padding:5px 0 6px;font:600 .74rem/1 var(--sans);color:var(--dkgreen)}
.cal.tba .cal-m{font-size:.56rem;letter-spacing:.06em}
.cal.tba .cal-d{color:var(--soft);padding-bottom:8px}
.ev.past .cal-m{background:var(--soft)}
.ev.past .cal-d{color:var(--soft)}
#home-next .ev-head{margin-bottom:8px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.ev-place{font-weight:500;margin:0 0 8px}
.ev p:last-child,.ev-desc>:last-child{margin-bottom:0}
.ev-desc ul,.ev-desc ol{margin:0 0 1em;padding-left:1.3em}
.ev-desc h4,.fb-intro h4{font-size:1.25rem;margin:.6em 0 .3em}
.ev-desc table,.fb-intro table{border-collapse:collapse;margin:0 0 1em;font-size:.92rem;width:auto;max-width:100%}
.ev-desc th,.ev-desc td,.fb-intro th,.fb-intro td{border-bottom:1px solid var(--cream2);padding:6px 14px 6px 0;text-align:left;vertical-align:top}
.ev-desc th,.fb-intro th{font-weight:600}
.ev-desc td p,.ev-desc th p,.fb-intro td p,.fb-intro th p{margin:0}
.ev-desc blockquote{margin:0 0 1em;padding-left:14px;border-left:3px solid var(--cream2);font-style:italic}
.ev.past{border-left-color:var(--cream2)}

@media (max-width:760px){.ev{grid-template-columns:minmax(0,1fr);padding:18px}.events-wrap{padding-left:5px;padding-right:5px}.events-wrap>.kicker,.events-wrap>.ev-none{padding-left:23px}}
/* testimonials */
#testimonios{position:relative}
.tq{margin:0;display:none}
.tq.on{display:block;animation:fade .6s ease}
.tq-dots{display:flex;justify-content:center;gap:10px;margin-top:22px}
.tq-dots button{all:unset;cursor:pointer;width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.4)}
.tq-dots button[aria-current="true"]{background:#fff}
/* contact */
form{display:grid;gap:14px}
label{font:600 .78rem var(--sans);letter-spacing:.08em;text-transform:uppercase}
input,textarea{width:100%;font:400 1rem var(--sans);padding:12px 14px;border:1.5px solid var(--cream2);border-radius:4px;background:#fff;color:var(--ink)}
textarea{min-height:130px;resize:vertical}
.formnote{font-size:.85rem;color:var(--dkgreen);min-height:1.4em}

footer{background:var(--dkgreen);color:#fff;padding:44px 0;font-size:.9rem}
footer .wrap{display:flex;gap:26px;align-items:center;flex-wrap:wrap}
footer img{width:72px;height:72px;background:var(--cream);border-radius:50%;padding:3px}
footer .name{font:500 1.5rem/1.1 var(--serif)}
footer a{color:#fff}
.foot-nav{max-width:1120px;margin:0 auto 30px;padding:0 28px 26px;display:flex;flex-wrap:wrap;gap:10px 28px;border-bottom:1px solid rgba(255,255,255,.2);font:500 .85rem var(--sans);letter-spacing:.04em}
.foot-nav a{text-decoration:none;opacity:.9}
@media (max-width:900px){
  .foot-nav{display:grid;grid-template-columns:max-content 1px 1fr;column-gap:26px;row-gap:14px;white-space:normal;justify-items:start}
  .foot-nav::before{content:"";grid-column:2;grid-row:1 / 4;width:1px;height:100%;background:rgba(255,255,255,.3)}
  .foot-nav a:nth-child(1){grid-column:1;grid-row:1}
  .foot-nav a:nth-child(2){grid-column:3;grid-row:1}
  .foot-nav a:nth-child(3){grid-column:1;grid-row:2}
  .foot-nav a:nth-child(4){grid-column:3;grid-row:2}
  .foot-nav a:nth-child(5){grid-column:1;grid-row:3}
}
@media (max-width:700px){footer .fine{flex-basis:100%;text-align:center !important}footer .wrap{gap:16px}footer img{width:56px;height:56px}footer .wrap>div:nth-child(2){min-width:0 !important}footer .name{font-size:1.25rem}}
.foot-nav a:hover{opacity:1;text-decoration:underline}
.foot-nav a.on{opacity:1;border-color:#fff}
.fine{opacity:.75;font-size:.8rem}
.deco{position:absolute;pointer-events:none}
.rel{position:relative}
{% endraw %}
</style>
</head>
<body>
{%- macro cal(t) -%}
<div class="cal{% if not t.fecha %} tba{% endif %}" aria-hidden="true">
  <div class="cal-m"><span class="es">{{ t.fecha | calMes("es") }}</span><span class="en">{{ t.fecha | calMes("en") }}</span></div>
  <div class="cal-d">{{ t.fecha | calDia }}</div>
  {%- if t.fecha %}<div class="cal-w"><span class="es">{{ t.fecha | calSemana("es") }}</span><span class="en">{{ t.fecha | calSemana("en") }}</span></div>{% endif %}
  {%- set h_es = t.fecha | calHora("es") %}{% set h_en = t.fecha | calHora("en") %}
  {%- if h_es %}<div class="cal-t"><span class="es">{{ h_es }}</span><span class="en">{{ h_en }}</span></div>{% endif %}
</div>
<span class="sr"><span class="es">{{ t.fecha | fecha("es") }}</span><span class="en">{{ t.fecha | fecha("en") }}</span></span>
{%- endmacro -%}

<div style="background:var(--ink);color:var(--cream);text-align:center;font:500 .72rem var(--sans);letter-spacing:.14em;text-transform:uppercase;padding:6px 10px"><span class="es">Borrador · vista previa</span><span class="en">Draft · preview</span></div>
<header>
  <div class="head">
    <a class="brand" href="#inicio"><img src="img/logo.png" alt="Logo de Mujeres Artesanas de Kingston"><span>Mujeres Artesanas<br>de Kingston</span></a>
    <nav id="main-nav">
      <a href="#inicio" data-view="inicio"><span class="es">Inicio</span><span class="en">Home</span></a>
      <a href="#quienes-somos" data-view="quienes-somos"><span class="es">Quiénes somos</span><span class="en">About</span></a>
      <a href="#talleres" data-view="talleres"><span class="es">Talleres y eventos</span><span class="en">Workshops &amp; events</span></a>
      <a href="#galeria" data-view="galeria"><span class="es">Galería</span><span class="en">Gallery</span></a>
      <a href="#apoyo" data-view="apoyo"><span class="es">Apoyo y contacto</span><span class="en">Support &amp; contact</span></a>
      <a href="#apoyo" class="nav-donar"><span class="es">Donar</span><span class="en">Donate</span></a>
    </nav>
    <div class="tools">
      <div class="lang" role="group" aria-label="Idioma / Language">
        <button type="button" data-lang="es" aria-pressed="true">ES</button>
        <button type="button" data-lang="en" aria-pressed="false">EN</button>
      </div>
      <a class="btn y" href="#apoyo"><span class="es">Donar</span><span class="en">Donate</span></a>
      <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="main-nav" aria-label="Menú / Menu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<main>

<!-- ============ INICIO ============ -->
<div class="view" id="v-inicio" data-c="green">
  <section class="hero" style="background-image:{% fondo encabezados.inicio.imagen, "img/ceramica.jpg" %};background-position:{{ encabezados.inicio.posicion | posicion }}">
    <div class="wrap" style="width:100%;position:relative">
      <div class="card">
        <div class="kicker"><span class="es">Arte · Tradición · Comunidad</span><span class="en">Art · Tradition · Community</span></div>
        <h1>Mujeres Artesanas de Kingston</h1>
        <p class="es">{{ inicio.lema | lineas | safe }}</p>
        <p class="en">{{ inicio.tagline | lineas | safe }}</p>
        <div class="btns">
          <a class="btn g" href="#talleres"><span class="es">Próximo taller</span><span class="en">Next workshop</span></a>
          <a class="btn o" href="#quienes-somos"><span class="es">Conócenos</span><span class="en">About us</span></a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="stats">
        <div class="stat"><b>18</b><span class="es">integrantes este año</span><span class="en">members this year</span></div>
        <div class="stat"><b>11</b><span class="es">países de origen</span><span class="en">countries of origin</span></div>
        <div class="stat"><b>8</b><span class="es">talleres mensuales</span><span class="en">monthly workshops</span></div>
        <div class="stat"><b>100%</b><span class="es">se sienten parte de una comunidad de confianza</span><span class="en">feel part of a trusted community</span></div>
      </div>
    </div>
  </section>

  <section class="paper" style="padding-top:64px">
    <div class="wrap">
      <div class="kicker"><span class="es">Cada mes</span><span class="en">Every month</span></div>
      <h2 class="es">{{ inicio.titulo_mes }}</h2>
      <h2 class="en">{{ inicio.title_month }}</h2>
      <div class="three" style="margin-top:28px">
        {%- set iconos = ["hoja.png","ojo.png","casa.png"] %}
        {%- for t in inicio.tarjetas %}
        <div class="feat" style="background:var(--cream)">
          <img class="icon" src="img/{{ iconos[loop.index0 % 3] }}" alt="">
          <h3 class="es">{{ t.titulo }}</h3><h3 class="en">{{ t.title }}</h3>
          <p class="es">{{ t.texto | lineas | safe }}</p>
          <p class="en">{{ t.text | lineas | safe }}</p>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <section class="band rel">
    <img class="deco" src="img/zig-amarillo.png" alt="" style="width:46px;left:6%;top:30px">
    <img class="deco" src="img/zig-turquesa.png" alt="" style="width:46px;right:7%;bottom:30px">
    <div class="wrap quote" id="testimonios">
      {%- for t in testimonios %}
      <figure class="tq{% if loop.first %} on{% endif %}">
        <blockquote class="es">“{{ (t.cita or t.quote) | lineas | safe }}”</blockquote>
        <blockquote class="en">“{{ (t.quote or t.cita) | lineas | safe }}”</blockquote>
        <cite class="es">— {{ t.autora or "Una participante" }}</cite><cite class="en">— {{ t.author or "A participant" }}</cite>
      </figure>
      {%- endfor %}
      {%- if testimonios.length > 1 %}
      <div class="tq-dots">{% for t in testimonios %}<button type="button" aria-label="{{ loop.index }}"{% if loop.first %} aria-current="true"{% endif %}></button>{% endfor %}</div>
      {%- endif %}
    </div>
  </section>

  <section>
    <div class="wrap split">
      <div>
        <div class="kicker"><span class="es">Próximo encuentro</span><span class="en">Next gathering</span></div>
        <div class="next" id="home-next">
          {%- set t = talleres[0] %}
          {%- if t %}
          <div class="ev-head">
            {{ cal(t) }}
            <div><h3 class="es">{{ t.titulo }}</h3><h3 class="en">{{ t.title or t.titulo }}</h3><p class="ev-place">{{ t.lugar }}</p></div>
          </div>
          {%- else %}
          <p class="es" style="margin:0">Pronto anunciaremos el próximo encuentro.</p><p class="en" style="margin:0">The next gathering will be announced soon.</p>
          {%- endif %}
          <p style="margin:12px 0 0"><a href="#talleres"><span class="es">Ver todos los talleres</span><span class="en">See all workshops</span></a></p>
        </div>
      </div>
      <img class="slice" src="img/exposicion.jpg" alt="Obras de las integrantes en la exposición de Radio Kingston">
    </div>
  </section>
</div>

<!-- ============ QUIÉNES SOMOS ============ -->
<div class="view" id="v-quienes-somos" data-c="yellow">
  <div class="pagehead">
    {%- if encabezados.quienes_somos.imagen %}
    <div class="banner" style="background-image:{% fondo encabezados.quienes_somos.imagen %};background-position:{{ encabezados.quienes_somos.posicion | posicion }}" role="img" aria-label=""></div>
    {%- else %}
    <div class="banner emblem" style="background-image:url(img/logo.png);background-color:var(--teal)" role="img" aria-label=""></div>
    {%- endif %}
    <div class="wrap intro">
      <h1><span class="es">Quiénes somos</span><span class="en">About</span></h1>
      <p class="alt"><span class="es">About</span><span class="en">Quiénes somos</span></p>
      <p class="lead es">Arte como sanación, tradición como recurso. Un grupo para mujeres inmigrantes hispanohablantes de Kingston, ahora en su cuarto año.</p>
      <p class="lead en">Art as healing, tradition as a resource. A group for Spanish-speaking immigrant women in Kingston, now in its fourth year.</p>
    </div>
  </div>

  <section style="padding-top:28px">
    <div class="wrap split" style="align-items:start">
      <div>
        <p class="es">Mujeres Artesanas reúne a mujeres inmigrantes hispanohablantes de nuestra comunidad para hacer artes visuales y artesanías, en talleres y estudios abiertos.</p>
        <p class="en">Mujeres Artesanas brings together Spanish-speaking immigrant women in our community for visual arts and crafts, through workshops and open studios.</p>
      </div>
      <div>
        <p class="es">Muchas mujeres llegan a Kingston desde Latinoamérica con un rico conocimiento de las tradiciones de sus países: textiles, papel, escultura, artesanía, cocina, música o danza. Conectar con el arte ayuda a recuperar esos recursos y a reconocer la propia fuerza y resiliencia.</p>
        <p class="en">Many women come to Kingston from Latin America with a deep knowledge of their countries' traditions: textiles, paper, sculpture, handicrafts, cooking, music or dance. Connecting with the arts helps reclaim those resources and recognize one's own strength and resilience.</p>
      </div>
    </div>
  </section>
  <section class="paper">
    <div class="wrap">
      <div class="kicker"><span class="es">Cómo trabajamos</span><span class="en">How we work</span></div>
      <div class="three">
        <div>
          <h3 class="es">Las participantes deciden</h3><h3 class="en">Participants decide</h3>
          <p class="es">Cada integrante elige su proyecto, y juntas decidimos cómo realizarlo y si queremos compartirlo.</p>
          <p class="en">Each member chooses her own project, and together we decide how to make it and whether to share it.</p>
        </div>
        <div>
          <h3 class="es">Apoyo psicosocial</h3><h3 class="en">Psychosocial support</h3>
          <p class="es">Gabriela Portas, terapeuta de artes creativas con licencia, facilita y acompaña al grupo. El propósito es el apoyo mutuo, no la intervención clínica.</p>
          <p class="en">Gabriela Portas, a licensed creative arts therapist, facilitates and supports the group. The purpose is mutual support, not clinical intervention.</p>
        </div>
        <div>
          <h3 class="es">Liderazgo compartido</h3><h3 class="en">Shared leadership</h3>
          <p class="es">Un comité coordinador de cuatro integrantes cuida los principios del grupo, recoge las ideas de todas y organiza los talleres.</p>
          <p class="en">A coordinating committee of four members looks after the group's principles, gathers everyone's ideas and organizes the workshops.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="paper"{% if not (informe.pdf_es or informe.pdf_en) %} hidden{% endif %}>
    <div class="wrap">
      <div class="kicker"><span class="es">{{ informe.titulo }}</span><span class="en">{{ informe.title or informe.titulo }}</span></div>
      <h2 class="es">Hojea nuestro informe</h2><h2 class="en">Flip through our report</h2>
      {%- if informe.intro %}<div class="es fb-intro">{{ informe.intro | richtext | safe }}</div>{% endif %}
      {%- if informe.intro_en or informe.intro %}<div class="en fb-intro">{{ (informe.intro_en or informe.intro) | richtext | safe }}</div>{% endif %}
      <p class="es fb-hint" style="max-width:680px">Haz clic en una esquina o arrastra para pasar la página.</p>
      <p class="en fb-hint" style="max-width:680px">Click a corner or drag to turn the page.</p>
      <div class="fb-wrap" style="margin-top:26px">
        <div class="fb-stage" id="fb-stage" data-pdf-es="{{ informe.pdf_es }}" data-pdf-en="{{ informe.pdf_en }}"><p class="fb-hint" id="fb-loading">…</p></div>
        <div class="fb-ctrl">
          <button type="button" id="fb-prev" aria-label="Anterior / Previous">&#8592;</button>
          <span id="fb-count"></span>
          <button type="button" id="fb-next" aria-label="Siguiente / Next">&#8594;</button>
          <button type="button" id="fb-full" class="fb-fullbtn" aria-label="Pantalla completa / Full screen" title="Pantalla completa / Full screen">&#x26F6;</button>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="kicker"><span class="es">Con el apoyo de</span><span class="en">With support from</span></div>
      <div class="chips">
        <span class="chip">Neighborhood Print Studio</span>
        <span class="chip">Kingston Ceramics Studio</span>
        <span class="chip">Radio Kingston</span>
        <span class="chip">Kingston Common Futures</span>
        <span class="chip">Circle Creative Collective <i class="es">· patrocinador fiscal</i><i class="en">· fiscal sponsor</i></span>
      </div>
    </div>
  </section>
</div>

<!-- ============ TALLERES ============ -->
<div class="view" id="v-talleres" data-c="orange">
  <div class="pagehead">
    <div class="banner" style="background-image:{% fondo encabezados.talleres.imagen, "img/textil.jpg" %};background-position:{{ encabezados.talleres.posicion | posicion }}" role="img" aria-label=""></div>
    <div class="wrap intro">
      <h1><span class="es">Talleres y eventos</span><span class="en">Workshops &amp; events</span></h1>
      <p class="alt"><span class="es">Workshops &amp; events</span><span class="en">Talleres y eventos</span></p>
      <p class="lead es">Nos reunimos una vez al mes para hacer arte, conversar y compartir una comida.</p>
      <p class="lead en">We meet once a month to make art, talk and share a meal.</p>
    </div>
  </div>

  <section style="padding-top:28px">
    <div class="wrap events-wrap">
      <div class="kicker"><span class="es">Próximos</span><span class="en">Coming up</span></div>
      <div class="events" id="ev-up">
        {%- for t in talleres %}
        <article class="ev{% if not t.imagen %} noimg{% endif %}" data-fecha="{{ t.fecha | iso }}">
          {%- if t.imagen %}<div class="ev-img">{% foto t.imagen, t.titulo, "", "(max-width: 760px) 100vw, 220px" %}</div>{% endif %}
          <div>
            <div class="ev-head">
              {{ cal(t) }}
              <div>
                <h3 class="es">{{ t.titulo }}</h3><h3 class="en">{{ t.title or t.titulo }}</h3>
                {%- if t.lugar %}<p class="ev-place">{{ t.lugar }}</p>{% endif %}
              </div>
            </div>
            {%- if t.texto %}<div class="es ev-desc">{{ t.texto | richtext | safe }}</div>{% endif %}
            {%- if t.text or t.texto %}<div class="en ev-desc">{{ (t.text or t.texto) | richtext | safe }}</div>{% endif %}
          </div>
        </article>
        {%- endfor %}
      </div>
      <p class="ev-none" hidden><span class="es">Pronto anunciaremos el próximo taller. {{ site.email | emailLink("Escríbenos") | safe }} para más información.</span><span class="en">The next workshop will be announced soon. {{ site.email | emailLink("Email us") | safe }} for details.</span></p>
      <div id="ev-past-wrap" hidden>
        <div class="kicker" style="margin-top:40px"><span class="es">Anteriores</span><span class="en">Past</span></div>
        <div class="events" id="ev-past"></div>
      </div>
    </div>
  </section>
  <section class="paper">
    <div class="wrap split rev" style="align-items:start">
      <div>
        <div class="kicker"><span class="es">Temporada 2025–2026</span><span class="en">2025–2026 season</span></div>
        <h2 class="es">Ocho talleres y una exposición</h2><h2 class="en">Eight workshops and an art show</h2>
        <p class="es">Desde octubre de 2025, 16 mujeres participaron en ocho talleres mensuales. La temporada terminó con una exposición en Radio Kingston en junio.</p>
        <p class="en">Since October 2025, 16 women took part in eight monthly workshops. The season ended with an art show at Radio Kingston in June.</p>
        <p class="es">Algunas integrantes ya dirigen sus propios talleres: una con el grupo, y dos en una escuela local, con remuneración.</p>
        <p class="en">Some members now lead their own workshops: one with the group, and two, paid, at a local school.</p>
      </div>
      <ul class="dots" style="columns:2;column-gap:28px;margin-top:8px">
        <li><span class="es">Decoupage y collage</span><span class="en">Decoupage and collage</span></li>
        <li><span class="es">Pintura</span><span class="en">Painting</span></li>
        <li><span class="es">Grabado en Neighborhood Print Studio</span><span class="en">Printmaking at Neighborhood Print Studio</span></li>
        <li><span class="es">Costura y quilting</span><span class="en">Sewing and quilting</span></li>
        <li><span class="es">Cestería</span><span class="en">Basket-making</span></li>
        <li><span class="es">Cerámica en Kingston Ceramics Studio</span><span class="en">Ceramics at Kingston Ceramics Studio</span></li>
        <li><span class="es">Crochet</span><span class="en">Crocheting</span></li>
        <li><span class="es">Adornos de papel tejido</span><span class="en">Woven paper ornaments</span></li>
      </ul>
    </div>
  </section>

  <section class="band rel">
    <img class="deco" src="img/zig-magenta.png" alt="" style="width:42px;right:6%;top:36px">
    <div class="wrap">
      <div class="kicker"><span class="es">Lo que viene</span><span class="en">What's ahead</span></div>
      <h2 class="es">Hacia dónde vamos</h2><h2 class="en">Where we're going</h2>
      <ul class="dots" style="max-width:780px;margin-top:20px">
        <li class="es">Profundizar en las artes tradicionales, con materiales de nuestras culturas y artistas invitadas expertas en artesanía tradicional</li>
        <li class="en">Deepen our commitment to traditional arts, with culturally specific materials and guest artists expert in traditional crafts</li>
        <li class="es">Reunir el trabajo individual en un tema común o un proyecto colectivo</li>
        <li class="en">Bring individual work together under a common theme or a group project</li>
        <li class="es">Crear oportunidades para que las integrantes con más experiencia enseñen</li>
        <li class="en">Create teaching opportunities for members with advanced skills</li>
        <li class="es">Vender nuestras obras y artesanías en mercados y ferias locales</li>
        <li class="en">Sell members' artwork and crafts at local markets and fairs</li>
      </ul>
    </div>
  </section>
</div>

<!-- ============ GALERÍA ============ -->
<div class="view" id="v-galeria" data-c="magenta">
  <div class="pagehead">
    <div class="banner" style="background-image:{% fondo encabezados.galeria.imagen, "img/exposicion.jpg" %};background-position:{{ encabezados.galeria.posicion | posicion }}" role="img" aria-label=""></div>
    <div class="wrap intro">
      <h1><span class="es">Galería</span><span class="en">Gallery</span></h1>
      <p class="alt"><span class="es">Gallery</span><span class="en">Galería</span></p>
      <p class="lead es">Hecho por nuestras manos: una muestra del trabajo de las integrantes. Pronto habrá más fotos.</p>
      <p class="lead en">Made by our hands: a sample of members' work. More photos coming soon.</p>
    </div>
  </div>

  <section style="padding-top:28px">
    <div class="wrap">
      <div class="gallery">
        {%- for g in galeria %}
        <figure tabindex="0">{% foto g.imagen, g.pie or g.caption %}<figcaption><span class="es">{{ g.pie or g.caption }}</span><span class="en">{{ g.caption or g.pie }}</span></figcaption></figure>
        {%- endfor %}
      </div>
    </div>
  </section>
</div>

<!-- ============ APOYO ============ -->
<div class="view" id="v-apoyo" data-c="blue">
  <div class="pagehead">
    {%- if encabezados.apoyo.imagen %}
    <div class="banner" style="background-image:{% fondo encabezados.apoyo.imagen %};background-position:{{ encabezados.apoyo.posicion | posicion }}" role="img" aria-label=""></div>
    {%- else %}
    <div class="banner emblem" style="background-image:url(img/ojo.png);background-color:var(--yellow)" role="img" aria-label=""></div>
    {%- endif %}
    <div class="wrap intro">
      <h1><span class="es">Apoyo y contacto</span><span class="en">Support &amp; contact</span></h1>
      <p class="alt"><span class="es">Support &amp; contact</span><span class="en">Apoyo y contacto</span></p>
      <p class="lead es">Tu donación paga materiales, talleres con artistas invitadas, la comida compartida y una compensación justa para el comité coordinador.</p>
      <p class="lead en">Your gift pays for materials, workshops with guest artists, the shared meal and fair pay for the coordinating committee.</p>
    </div>
  </div>

  <section style="padding-top:20px;padding-bottom:20px">
    <div class="wrap">
      <p class="es" style="max-width:720px">Las donaciones se hacen a través de nuestro patrocinador fiscal, Circle Creative Collective, una organización 501(c)(3), y son deducibles de impuestos. Para que tu donación llegue a Mujeres Artesanas:</p>
      <p class="en" style="max-width:720px">Donations go through our fiscal sponsor, Circle Creative Collective, a 501(c)(3) nonprofit, and are tax-deductible. To make sure your gift reaches Mujeres Artesanas:</p>
      <div class="steps3">
        <div><b>1</b><span class="es">Haz clic en «Donar». Se abrirá la página de donaciones de Circle Creative Collective.</span><span class="en">Click "Donate". Circle Creative Collective's donation page opens.</span></div>
        <div><b>2</b><span class="es">Elige el monto y si quieres donar una vez o cada mes.</span><span class="en">Choose an amount, and whether to give once or monthly.</span></div>
        <div><b>3</b><span class="es">En las notas, escribe:</span><span class="en">In the notes, write:</span>
          <div class="copyline"><code>Mujeres Artesanas de Kingston</code><button type="button" id="copy-note"><span class="es">Copiar</span><span class="en">Copy</span></button></div></div>
      </div>
      <div class="btns"><a class="btn y" href="https://www.circlecreativecollective.org/donate" target="_blank" rel="noopener"><span class="es">Donar a Mujeres Artesanas</span><span class="en">Donate to Mujeres Artesanas</span></a></div>
    </div>
  </section>
  <section>
    <div class="wrap split" style="align-items:start">
      <div>
        <div class="kicker"><span class="es">Contacto</span><span class="en">Contact</span></div>
        <h2 class="es">Escríbenos</h2><h2 class="en">Get in touch</h2>
        <p class="es">¿Quieres participar, ofrecer un taller o colaborar con el grupo? Nos encantaría saber de ti.</p>
        <p class="en">Would you like to join, offer a workshop or partner with the group? We'd love to hear from you.</p>
        <p><strong>Email</strong><br>{{ site.email | emails | safe }}</p>
        <p><strong class="es">Dirección</strong><strong class="en">Address</strong><br>231 Clinton Ave.<br>Kingston, NY 12401</p>
      </div>
      <form id="contact" novalidate>
        <div><label for="f-name"><span class="es">Nombre</span><span class="en">Name</span></label><input id="f-name" name="name" autocomplete="name"></div>
        <div><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email"></div>
        <div><label for="f-msg"><span class="es">Mensaje</span><span class="en">Message</span></label><textarea id="f-msg" name="message"></textarea></div>
        <div><button class="btn g" type="submit"><span class="es">Enviar</span><span class="en">Send</span></button></div>
        <div class="formnote" id="formnote" aria-live="polite"></div>
      </form>
    </div>
  </section>
</div>

</main>

<div class="lb" id="lb" hidden role="dialog" aria-modal="true" aria-label="Galería">
  <button type="button" class="lb-x" aria-label="Cerrar / Close">&#10005;</button>
  <button type="button" class="lb-fs" aria-label="Pantalla completa / Full screen" title="Pantalla completa / Full screen" hidden>&#x26F6;</button>
  <button type="button" class="lb-prev" aria-label="Anterior / Previous">&#8592;</button>
  <img alt="">
  <div class="lb-cap"></div>
  <div class="lb-n"></div>
  <button type="button" class="lb-next" aria-label="Siguiente / Next">&#8594;</button>
</div>

<div class="fb-full" id="fb-full-overlay" hidden role="dialog" aria-modal="true" aria-label="Informe">
  <button type="button" class="fb-close" id="fb-close" aria-label="Cerrar / Close">&#10005;</button>
  <div class="fb-full-slot" id="fb-full-slot"></div>
</div>

<footer>
  <nav class="foot-nav" aria-label="Menú / Menu">
    <a href="#inicio" data-view="inicio"><span class="es">Inicio</span><span class="en">Home</span></a>
    <a href="#quienes-somos" data-view="quienes-somos"><span class="es">Quiénes somos</span><span class="en">About</span></a>
    <a href="#talleres" data-view="talleres"><span class="es">Talleres y eventos</span><span class="en">Workshops &amp; events</span></a>
    <a href="#galeria" data-view="galeria"><span class="es">Galería</span><span class="en">Gallery</span></a>
    <a href="#apoyo" data-view="apoyo"><span class="es">Apoyo y contacto</span><span class="en">Support &amp; contact</span></a>
  </nav>
  <div class="wrap">
    <img src="img/logo.png" alt="">
    <div style="flex:1;min-width:240px">
      <div class="name">Mujeres Artesanas de Kingston</div>
      231 Clinton Ave., Kingston, NY 12401<br>{{ site.email | emails | safe }}
    </div>
    <div class="fine" style="text-align:right"><span class="es">Patrocinio fiscal:</span><span class="en">Fiscally sponsored by</span> Circle Creative Collective<br>© 2026 Mujeres Artesanas de Kingston</div>
  </div>
</footer>

<script src="js/page-flip.browser.js"></script>
<script>
{% raw %}
(function(){
  var views=["inicio","quienes-somos","talleres","galeria","apoyo"];
  function show(){
    var h=(location.hash||"").replace("#","");
    if(views.indexOf(h)<0) h="inicio";
    views.forEach(function(v){
      document.getElementById("v-"+v).classList.toggle("on",v===h);
    });
    document.querySelectorAll("nav a").forEach(function(a){a.classList.toggle("on",a.dataset.view===h)});
    var c=document.getElementById("v-"+h).dataset.c; document.documentElement.style.setProperty("--navc","var(--"+c+")");
    window.scrollTo(0,0);
    if(h==="quienes-somos") initFlip();
  }

  var flip=null,flipUrl=null,flipBusy=false,fbPages=null,fbRatio=1.3,fbBig=false;
  var stage=document.getElementById("fb-stage"),fbWrap=stage.parentNode,fbHome=fbWrap.parentNode,fbAnchor=fbWrap.nextSibling,
      fbPrev=document.getElementById("fb-prev"),fbNext=document.getElementById("fb-next"),fbCnt=document.getElementById("fb-count"),
      fbOverlay=document.getElementById("fb-full-overlay"),fbSlot=document.getElementById("fb-full-slot");
  fbPrev.addEventListener("click",function(){if(flip)flip.flipPrev()});
  fbNext.addEventListener("click",function(){if(flip)flip.flipNext()});
  function pdfFor(lang){var es=stage.dataset.pdfEs,en=stage.dataset.pdfEn;return lang==="en"?(en||es):(es||en);}

  function mountFlip(startAt){
    if(flip){try{flip.destroy()}catch(e){} flip=null;}
    stage.innerHTML="";
    var book=document.createElement("div");book.id="flipbook";
    fbPages.forEach(function(src,i){var d=document.createElement("div");d.className="fb-page";var im=document.createElement("img");im.alt="";im.src=src;d.appendChild(im);book.appendChild(d);});
    stage.appendChild(book);
    var opts={showCover:true,maxShadowOpacity:.45,mobileScrollSupport:false,usePortrait:true,autoSize:true,startPage:startAt||0};
    if(fbBig){
      var availH=window.innerHeight-150,availW=window.innerWidth-48,single=window.innerWidth<760;
      var pw=Math.floor(Math.min(availH/fbRatio,single?availW:availW/2));
      stage.style.width=(single?pw:pw*2)+"px";
      opts.size="fixed";opts.width=pw;opts.height=Math.round(pw*fbRatio);
    }else{
      stage.style.width="";
      opts.size="stretch";opts.width=500;opts.height=Math.round(500*fbRatio);
      opts.minWidth=260;opts.maxWidth=520;opts.minHeight=Math.round(260*fbRatio);opts.maxHeight=Math.round(520*fbRatio);
    }
    var f=flip=new St.PageFlip(book,opts);
    flip.loadFromHTML(book.querySelectorAll(".fb-page"));
    /* showCover makes the cover a stiff "hard" page; make it curl like the others */
    function softCover(){try{f.getPage(0).setDensity("soft")}catch(e){}}
    softCover();flip.on("changeOrientation",softCover);
    var n=flip.getPageCount();
    function upd(){var i=f.getCurrentPageIndex();document.body.classList.toggle("fb-closed",i===0);fbCnt.textContent=(i+1)+" / "+n;fbPrev.disabled=i===0;fbNext.disabled=i>=n-1;}
    flip.on("flip",upd);flip.on("changeOrientation",upd);upd();
  }

  async function initFlip(){
    if(typeof St==="undefined"||flipBusy) return;
    var url=pdfFor(document.documentElement.lang);
    if(!url){stage.closest("section").hidden=true;return;}
    if(url===flipUrl&&flip) return;
    flipBusy=true;
    var es=document.documentElement.lang==="es";
    try{
      if(flip){try{flip.destroy()}catch(e){} flip=null;}
      stage.innerHTML='<p class="fb-hint">'+(es?"Cargando el informe…":"Loading the report…")+'</p>';
      var pdfjs=await import(new URL("js/pdfjs/pdf.min.mjs",location.href).href);
      pdfjs.GlobalWorkerOptions.workerSrc=new URL("js/pdfjs/pdf.worker.min.mjs",location.href).href;
      var doc=await pdfjs.getDocument({url:new URL(url,location.href).href}).promise;
      var pages=[];
      for(var i=1;i<=doc.numPages;i++){
        var page=await doc.getPage(i),vp1=page.getViewport({scale:1});
        if(i===1) fbRatio=vp1.height/vp1.width;
        var vp=page.getViewport({scale:1600/vp1.height}),c=document.createElement("canvas");
        c.width=Math.round(vp.width);c.height=Math.round(vp.height);
        await page.render({canvasContext:c.getContext("2d"),canvas:c,viewport:vp}).promise;
        pages.push(c.toDataURL("image/jpeg",.85));
      }
      fbPages=pages;flipUrl=url;
      mountFlip(0);
    }catch(e){
      stage.innerHTML='<p class="fb-hint">'+(es?"No se pudo cargar el informe.":"The report could not be loaded.")+'</p>';
    }
    flipBusy=false;
  }

  /* full screen */
  function openFull(){
    if(!fbPages) return;
    var at=flip?flip.getCurrentPageIndex():0;
    fbSlot.appendChild(fbWrap);fbOverlay.hidden=false;document.body.style.overflow="hidden";fbBig=true;
    try{if(fbOverlay.requestFullscreen)fbOverlay.requestFullscreen().catch(function(){});}catch(e){}
    setTimeout(function(){mountFlip(at)},60);
    document.getElementById("fb-close").focus();
  }
  function closeFull(){
    if(fbOverlay.hidden) return;
    var at=flip?flip.getCurrentPageIndex():0;
    try{if(document.fullscreenElement)document.exitFullscreen().catch(function(){});}catch(e){}
    fbHome.insertBefore(fbWrap,fbAnchor);fbOverlay.hidden=true;document.body.style.overflow="";fbBig=false;
    mountFlip(at);
  }
  document.getElementById("fb-full").addEventListener("click",openFull);
  document.getElementById("fb-close").addEventListener("click",closeFull);
  document.addEventListener("keydown",function(e){
    if(fbOverlay.hidden) return;
    if(e.key==="Escape") closeFull();
    else if(e.key==="ArrowRight"&&flip) flip.flipNext();
    else if(e.key==="ArrowLeft"&&flip) flip.flipPrev();
  });
  document.addEventListener("fullscreenchange",function(){if(!document.fullscreenElement&&!fbOverlay.hidden)closeFull();});
  var fbResize=null;
  window.addEventListener("resize",function(){if(!fbBig)return;clearTimeout(fbResize);fbResize=setTimeout(function(){mountFlip(flip?flip.getCurrentPageIndex():0)},200);});

  var hdr=document.querySelector("header"),mb=document.getElementById("menu-btn");
  function setMenu(open){hdr.classList.toggle("open",open);mb.setAttribute("aria-expanded",open?"true":"false");}
  mb.addEventListener("click",function(){setMenu(!hdr.classList.contains("open"))});
  window.addEventListener("hashchange",function(){setMenu(false)});
  document.addEventListener("keydown",function(e){if(e.key==="Escape")setMenu(false)});
  window.addEventListener("hashchange",show); show();

  function setLang(l){
    document.documentElement.lang=l;
    document.querySelectorAll(".lang button").forEach(function(b){b.setAttribute("aria-pressed",b.dataset.lang===l?"true":"false")});
    try{localStorage.setItem("ma-lang",l)}catch(e){}
    if(typeof flipUrl!=="undefined"&&flipUrl&&(location.hash==="#quienes-somos")) initFlip();
  }
  var saved=null; try{saved=localStorage.getItem("ma-lang")}catch(e){}
  setLang(saved==="en"?"en":"es");
  document.querySelectorAll(".lang button").forEach(function(b){b.addEventListener("click",function(){setLang(b.dataset.lang)})});



  /* events: move past ones to "Past", pick the next one for the homepage */
  (function(){
    var up=document.getElementById("ev-up"),past=document.getElementById("ev-past");if(!up)return;
    var today=new Date();today.setHours(0,0,0,0);
    [].slice.call(up.querySelectorAll(".ev")).forEach(function(ev){
      var f=ev.dataset.fecha;if(!f)return;
      var d=new Date(f.length<=10?f+"T23:59":f);
      if(d<today){ev.classList.add("past");past.insertBefore(ev,past.firstChild);}
    });
    document.getElementById("ev-past-wrap").hidden=!past.children.length;
    var first=up.querySelector(".ev");
    document.querySelector(".ev-none").hidden=!!first;
    var hn=document.getElementById("home-next");
    if(hn){
      var link=hn.lastElementChild;
      if(first){
        hn.innerHTML="";
        var body=first.querySelector(".ev-img")?first.children[1]:first.children[0];
        [].slice.call(body.children).forEach(function(c){var k=c.cloneNode(true);hn.appendChild(k);});
        hn.appendChild(link);
      }else{
        hn.innerHTML='<p class="es" style="margin:0">Pronto anunciaremos el próximo encuentro.</p><p class="en" style="margin:0">The next gathering will be announced soon.</p>';
        hn.appendChild(link);
      }
    }
  })();

  /* testimonials: rotate every 9 seconds */
  (function(){
    var box=document.getElementById("testimonios");if(!box)return;
    var qs=[].slice.call(box.querySelectorAll(".tq")),dots=[].slice.call(box.querySelectorAll(".tq-dots button")),i=0,timer=null;
    if(qs.length<2)return;
    function go(n){qs[i].classList.remove("on");dots[i].removeAttribute("aria-current");i=(n+qs.length)%qs.length;qs[i].classList.add("on");dots[i].setAttribute("aria-current","true");}
    function start(){clearInterval(timer);timer=setInterval(function(){go(i+1)},9000);}
    dots.forEach(function(d,n){d.addEventListener("click",function(){go(n);start();})});
    var sx=null,sy=null;
    box.addEventListener("touchstart",function(e){sx=e.touches[0].clientX;sy=e.touches[0].clientY;},{passive:true});
    box.addEventListener("touchend",function(e){
      if(sx===null)return;var dx=e.changedTouches[0].clientX-sx,dy=e.changedTouches[0].clientY-sy;sx=null;
      if(Math.abs(dx)>40&&Math.abs(dx)>Math.abs(dy)){go(i+(dx<0?1:-1));start();}
    });
    start();
  })();

  /* e-mail links: the address is stored reversed so bots can't read it */
  /* the address is only put together at the moment someone clicks */
  document.addEventListener("click",function(e){
    var a=e.target.closest&&e.target.closest("a.em");if(!a)return;
    e.preventDefault();
    var r=function(x){return x.split("").reverse().join("")};
    window.location.href="mailto:"+r(a.dataset.u)+String.fromCharCode(64)+r(a.dataset.d);
  });

  /* gallery slideshow */
  var figs=[].slice.call(document.querySelectorAll(".gallery figure")),lb=document.getElementById("lb"),
      lbImg=lb.querySelector("img"),lbCap=lb.querySelector(".lb-cap"),lbN=lb.querySelector(".lb-n"),cur=0,lastFocus=null;
  function cap(f){var l=document.documentElement.lang;var sp=f.querySelector("figcaption ."+l);return sp?sp.textContent:"";}
  function render(i){
    cur=(i+figs.length)%figs.length;var f=figs[cur],im=f.querySelector("img");var full=im.dataset.full||im.currentSrc||im.src;
    lbImg.classList.add("fading");
    setTimeout(function(){lbImg.src=full;lbImg.alt=im.alt;lbCap.textContent=cap(f);lbN.textContent=(cur+1)+" / "+figs.length;lbImg.classList.remove("fading");},120);
  }
  function openLb(i){lastFocus=document.activeElement;lb.hidden=false;document.body.style.overflow="hidden";render(i);lb.querySelector(".lb-x").focus();}
  function closeLb(){try{if(document.fullscreenElement)document.exitFullscreen().catch(function(){});}catch(e){}lb.hidden=true;document.body.style.overflow="";if(lastFocus&&lastFocus.blur)lastFocus.blur();}
  figs.forEach(function(f,i){
    f.querySelector("img").addEventListener("click",function(){openLb(i)});
    f.addEventListener("keydown",function(e){if(e.key==="Enter"){openLb(i)}});
  });
  lb.querySelector(".lb-x").addEventListener("click",closeLb);
  var lbFs=lb.querySelector(".lb-fs");
  if(document.fullscreenEnabled&&lb.requestFullscreen){
    lbFs.hidden=false;
    lbFs.addEventListener("click",function(){
      if(document.fullscreenElement){document.exitFullscreen().catch(function(){});}
      else{lb.requestFullscreen().catch(function(){});}
    });
  }
  lb.querySelector(".lb-prev").addEventListener("click",function(){render(cur-1)});
  lb.querySelector(".lb-next").addEventListener("click",function(){render(cur+1)});
  lb.addEventListener("click",function(e){if(e.target===lb)closeLb()});
  document.addEventListener("keydown",function(e){
    if(lb.hidden)return;
    if(e.key==="Escape")closeLb();else if(e.key==="ArrowLeft")render(cur-1);else if(e.key==="ArrowRight")render(cur+1);
  });
  var tx=null;
  lb.addEventListener("touchstart",function(e){tx=e.touches[0].clientX},{passive:true});
  lb.addEventListener("touchend",function(e){if(tx===null)return;var dx=e.changedTouches[0].clientX-tx;if(Math.abs(dx)>40)render(cur+(dx<0?1:-1));tx=null;});
  window.addEventListener("hashchange",function(){if(!lb.hidden)closeLb()});
  document.getElementById("copy-note").addEventListener("click",function(){
    var b=this;
    try{navigator.clipboard.writeText("Mujeres Artesanas de Kingston").then(function(){b.dataset.ok=1;b.style.background="var(--green)";b.style.color="#fff";b.style.borderColor="var(--green)";},function(){});}catch(e){}
  });
  document.getElementById("contact").addEventListener("submit",function(e){
    e.preventDefault();
    var es=document.documentElement.lang==="es";
    document.getElementById("formnote").textContent=es
      ?"Este formulario todavía no está conectado. Por ahora, escríbenos por email (ver a la izquierda)."
      :"This form isn't connected yet. For now, please email us (see left).";
  });
})();
{% endraw %}
</script>
</body>
</html>
